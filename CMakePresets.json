{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "description": "Visual Studio 2022 with MSVC compiler, Debug configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.8.2/msvc2022_64;C:/Users/weichen/vcpkg/installed/x64-windows",
                "Exiv2_DIR": "C:/Users/weichen/vcpkg/installed/x64-windows/share/exiv2",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_GUI": "ON",
                "EZSPECCAM_BUILD_CLI": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "description": "Visual Studio 2022 with MSVC compiler, Release configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.8.2/msvc2022_64;C:/Users/weichen/vcpkg/installed/x64-windows",
                "Exiv2_DIR": "C:/Users/weichen/vcpkg/installed/x64-windows/share/exiv2",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_GUI": "ON",
                "EZSPECCAM_BUILD_CLI": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug (Linux)",
            "description": "GCC compiler, Debug configuration for Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "$env{QT_DIR}",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release (Linux)",
            "description": "GCC compiler, Release configuration for Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gcc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "$env{QT_DIR}",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20"
            }
        },
        {
            "name": "msvc-debug-gui",
            "displayName": "MSVC Debug GUI",
            "description": "Visual Studio 2022 with MSVC compiler, Debug configuration, GUI only",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-debug-gui",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.8.2/msvc2022_64;C:/Users/weichen/vcpkg/installed/x64-windows",
                "Exiv2_DIR": "C:/Users/weichen/vcpkg/installed/x64-windows/share/exiv2",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_GUI": "ON",
                "EZSPECCAM_BUILD_CLI": "OFF",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug",
            "description": "Build MSVC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "description": "Build MSVC Release configuration",
            "configuration": "Release"
        },
        {
            "name": "msvc-release-install",
            "configurePreset": "msvc-release",
            "description": "Build and install MSVC Release configuration",
