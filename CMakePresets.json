            "targets": ["install"]
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "description": "Build GCC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "description": "Build GCC Release configuration",
            "configuration": "Release"
        },
        {
            "name": "gcc-release-install",
            "configurePreset": "gcc-release",
            "description": "Build and install GCC Release configuration",
            "configuration": "Release",
            "targets": ["install"]
        },
        {
            "name": "msvc-debug-gui",
            "configurePreset": "msvc-debug-gui",
            "description": "Build MSVC Debug GUI configuration",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug",
            "description": "Run tests with MSVC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "description": "Run tests with MSVC Release configuration",
            "configuration": "Release"
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "description": "Run tests with GCC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "description": "Run tests with GCC Release configuration",
            "configuration": "Release"
        }
    ]
}
