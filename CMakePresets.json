{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "description": "Visual Studio 2022 with MSVC compiler, Debug configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "$penv{QT_DIR}",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_APP": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON",
                "EZSPECCAM_PICAM_DEMO": "ON"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "description": "Visual Studio 2022 with MSVC compiler, Release configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "$penv{QT_DIR}",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_APP": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON",
                "EZSPECCAM_PICAM_DEMO": "ON"
            }
        },
        {
            "name": "msvc-debug-gui",
            "displayName": "MSVC Debug GUI",
            "description": "Visual Studio 2022 with MSVC compiler, Debug configuration (legacy name; binary is unified)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc-debug-gui",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_PREFIX_PATH": "$penv{QT_DIR}",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_APP": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "OFF",
                "EZSPECCAM_PICAM_DEMO": "ON"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "GCC + Ninja, Debug configuration (mock driver only)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "/usr",
                "QT_NO_PACKAGE_VERSION_CHECK": "TRUE",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_APP": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON",
                "EZSPECCAM_PICAM_DEMO": "OFF"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "GCC + Ninja, Release configuration (mock driver only)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "/usr",
                "QT_NO_PACKAGE_VERSION_CHECK": "TRUE",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.20",
                "EZSPECCAM_BUILD_APP": "ON",
                "EZSPECCAM_BUILD_PLUGINS": "ON",
                "EZSPECCAM_BUILD_TESTS": "ON",
                "EZSPECCAM_PICAM_DEMO": "OFF"
            }
        }
     ],
     "buildPresets": [
         {
             "name": "msvc-debug",
            "configurePreset": "msvc-debug",
            "description": "Build MSVC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "description": "Build MSVC Release configuration",
            "configuration": "Release"
        },
        {
            "name": "msvc-debug-gui",
            "configurePreset": "msvc-debug-gui",
            "description": "Build MSVC Debug GUI configuration",
            "configuration": "Debug"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "description": "Build Linux Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "description": "Build Linux Release configuration",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug",
            "description": "Run tests with MSVC Debug configuration",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "description": "Run tests with MSVC Release configuration",
            "configuration": "Release"
        }
    ]
}
